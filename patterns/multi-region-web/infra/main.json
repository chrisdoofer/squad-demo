        "httpPort": 80,
        "httpsPort": 443,
        "originHostHeader": "[reference(resourceId('Microsoft.Web/sites', variables('secondaryWebAppName')), '2023-12-01').defaultHostName]",
        "priority": 2,
        "weight": 1000,
        "enabledState": "Enabled"
      },
      "dependsOn": [
