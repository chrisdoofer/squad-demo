{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "5428404542513982568"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "hubAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/16",
      "metadata": {
        "description": "Address prefix for the hub VNet (e.g. 10.0.0.0/16)."
      }
    },
    "spoke1AddressPrefix": {
      "type": "string",
      "defaultValue": "10.1.0.0/16",
      "metadata": {
        "description": "Address prefix for spoke 1 VNet (e.g. 10.1.0.0/16)."
      }
    },
    "spoke2AddressPrefix": {
      "type": "string",
      "defaultValue": "10.2.0.0/16",
      "metadata": {
        "description": "Address prefix for spoke 2 VNet (e.g. 10.2.0.0/16)."
      }
    },
    "firewallSkuTier": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "SKU tier for the Azure Firewall."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "hubVNetName": "[format('vnet-hub-{0}', variables('uniqueSuffix'))]",
    "spoke1VNetName": "[format('vnet-spoke1-{0}', variables('uniqueSuffix'))]",
    "spoke2VNetName": "[format('vnet-spoke2-{0}', variables('uniqueSuffix'))]",
    "firewallName": "[format('fw-hub-{0}', variables('uniqueSuffix'))]",
    "firewallPolicyName": "[format('fwpol-hub-{0}', variables('uniqueSuffix'))]",
    "firewallPublicIpName": "[format('pip-fw-{0}', variables('uniqueSuffix'))]",
    "bastionName": "[format('bastion-hub-{0}', variables('uniqueSuffix'))]",
    "bastionPublicIpName": "[format('pip-bastion-{0}', variables('uniqueSuffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-01-01",
      "name": "[variables('hubVNetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('hubAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "AzureFirewallSubnet",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('hubAddressPrefix'), 26, 0)]"
            }
          },
          {
            "name": "GatewaySubnet",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('hubAddressPrefix'), 26, 1)]"
            }
          },
          {
            "name": "AzureBastionSubnet",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('hubAddressPrefix'), 26, 2)]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-01-01",
      "name": "[variables('spoke1VNetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('spoke1AddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "default",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('spoke1AddressPrefix'), 24, 0)]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-01-01",
      "name": "[variables('spoke2VNetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('spoke2AddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "default",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('spoke2AddressPrefix'), 24, 0)]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', variables('hubVNetName'), 'hub-to-spoke1')]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('spoke1VNetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": true,
        "allowGatewayTransit": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('spoke1VNetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', variables('spoke1VNetName'), 'spoke1-to-hub')]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": true,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('spoke1VNetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', variables('hubVNetName'), 'hub-to-spoke2')]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('spoke2VNetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": true,
        "allowGatewayTransit": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('spoke2VNetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', variables('spoke2VNetName'), 'spoke2-to-hub')]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": true,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('spoke2VNetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/firewallPolicies",
      "apiVersion": "2024-01-01",
      "name": "[variables('firewallPolicyName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "tier": "[parameters('firewallSkuTier')]"
        },
        "threatIntelMode": "Alert"
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-01-01",
      "name": "[variables('firewallPublicIpName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/azureFirewalls",
      "apiVersion": "2024-01-01",
      "name": "[variables('firewallName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "AZFW_VNet",
          "tier": "[parameters('firewallSkuTier')]"
        },
        "firewallPolicy": {
          "id": "[resourceId('Microsoft.Network/firewallPolicies', variables('firewallPolicyName'))]"
        },
        "ipConfigurations": [
          {
            "name": "fw-ipconfig",
            "properties": {
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('firewallPublicIpName'))]"
              },
              "subnet": {
                "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName')), '2024-01-01').subnets[0].id]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/firewallPolicies', variables('firewallPolicyName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('firewallPublicIpName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-01-01",
      "name": "[variables('bastionPublicIpName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/bastionHosts",
      "apiVersion": "2024-01-01",
      "name": "[variables('bastionName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "ipConfigurations": [
          {
            "name": "bastion-ipconfig",
            "properties": {
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('bastionPublicIpName'))]"
              },
              "subnet": {
                "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName')), '2024-01-01').subnets[2].id]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('bastionPublicIpName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]"
      ]
    }
  ],
  "outputs": {
    "hubVNetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('hubVNetName'))]"
    },
    "spoke1VNetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('spoke1VNetName'))]"
    },
    "spoke2VNetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('spoke2VNetName'))]"
    },
    "firewallPrivateIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/azureFirewalls', variables('firewallName')), '2024-01-01').ipConfigurations[0].properties.privateIPAddress]"
    },
    "firewallPublicIpAddress": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('firewallPublicIpName')), '2024-01-01').ipAddress]"
    },
    "bastionId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/bastionHosts', variables('bastionName'))]"
    },
    "firewallPolicyId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/firewallPolicies', variables('firewallPolicyName'))]"
    }
  }
}